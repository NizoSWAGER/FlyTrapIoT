
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar trampa"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etSectorEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código del sector"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etTipoEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo de trampa"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etNivelEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nivel de captura"
            android:inputType="number"/>

        <EditText
            android:id="@+id/etObservacionesEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observaciones"
            android:inputType="textMultiLine"
            android:minLines="2"/>

        <Button
            android:id="@+id/btnActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actualizar trampa"/>

        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eliminar trampa"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>
